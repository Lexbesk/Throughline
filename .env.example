# Copy to .env and fill in. .env is gitignored and loaded automatically.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: only needed for GPT models (any gpt-* model routes to OpenAI).
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: only needed for the postgres store backend (v4). Local dev URL for
# the Docker Postgres from deploy/docker-compose.yml; production uses the
# managed database's URL via platform secrets, never this file.
# DATABASE_URL=postgresql://throughline:throughline@localhost:5432/throughline
# Required for the postgres backend's per-user API keys (v4 M18): the master key
# that encrypts stored keys at rest. Generate one with `meeting-notes-todos keygen`.
# Keep it stable — it decrypts existing keys. Never commit a real value.
# THROUGHLINE_MASTER_KEY=
